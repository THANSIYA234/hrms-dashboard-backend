# Copy this file to `.env` and fill in real values.
# Rotate any secrets that ever appeared in version control.

# Server
PORT=5000

# `development` keeps auth cookies on SameSite=Lax so they work over plain
# http on localhost. `production` switches to SameSite=None + Secure, which is
# required because the deployed frontend is a different registrable domain
# (netlify.app -> onrender.com) and always runs over HTTPS.
NODE_ENV=development

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# MongoDB
MONGO_URI=

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=
REFRESH_SECRET=

# CORS — comma-separated list of origins allowed to call the API
# The frontend origin MUST match exactly; credentials are not allowed from "*".
CORS_ORIGINS=http://localhost:5173